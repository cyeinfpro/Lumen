{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "skipLibCheck": false,
    "types": [
      "node", "react", "react-dom", "next", "next/image-types/global",
      "urlpattern-polyfill"
    ]
  },
  "include": [
    "**/*.ts", "**/*.tsx", "**/*.mts",
    ".next-build-check/types/**/*.ts"
  ],
  "exclude": [
    "node_modules", "next-env.d.ts", ".next", ".next/dev/types", ".next-e2e", ".next-ux",
    ".next-build-check/dev"
  ]
}
