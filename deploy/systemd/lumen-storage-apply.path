[Unit]
Description=Lumen storage apply request watcher
After=multi-user.target

[Path]
# lumen-api writes immutable operation_id.fence requests. DirectoryNotEmpty
# retriggers after service exit until every request has a terminal result.
DirectoryNotEmpty=/var/lib/lumen-storage/requests
Unit=lumen-storage-apply.service

[Install]
WantedBy=multi-user.target
