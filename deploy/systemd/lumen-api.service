[Unit]
Description=Lumen API
After=network-online.target docker.service lumen-storage-mount.service
Wants=network-online.target
Requires=docker.service lumen-storage-mount.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=lumen
Group=lumen
# release 布局：current 是软链，systemd 在 chdir 时按 cwd= 软链解引用进入物理 release 目录。
WorkingDirectory=/opt/lumen/current/apps/api
EnvironmentFile=-/opt/lumen/shared/.env
# LUMEN_VERSION 从 EnvironmentFile 读取，由 deploy/scripts/sync_env_version.sh 在每次发布时刷新。
Environment=PYTHONUNBUFFERED=1
# lumen-storage-mount.service owns privileged mount repair. The API only
# performs a fail-closed check as its unprivileged service account.
ExecStartPre=/usr/local/sbin/lumen-storage-mount verify
ExecStartPre=/usr/bin/test -w /opt/lumendata/storage
ExecStart=/opt/lumen/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --limit-max-requests 10000 --limit-max-requests-jitter 1000 --timeout-keep-alive 60 --timeout-graceful-shutdown 30 --timeout-worker-healthcheck 10
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
CapabilityBoundingSet=
# Release code and shared configuration stay read-only to the service account.
ReadWritePaths=/opt/lumendata/storage /opt/lumendata/backup /var/lib/lumen-storage
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumen-api

[Install]
WantedBy=multi-user.target
