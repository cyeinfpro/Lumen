[Unit]
Description=Lumen storage mount (/opt/lumendata)
After=network-online.target
Wants=network-online.target
# Docker must never initialize bind sources on the unmounted backing directory.
# `RequiredBy=docker.service` installs the hard dependency; this ordering makes
# a non-zero mount/identity result block the Docker start transaction.
Before=docker.service lumen-api.service lumen-worker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=LUMEN_STORAGE_TARGET=/opt/lumendata
ExecStart=/usr/local/sbin/lumen-storage-mount up
ExecStartPost=/usr/local/sbin/lumen-storage-mount verify
ExecStop=/usr/local/sbin/lumen-storage-mount down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
RequiredBy=docker.service
