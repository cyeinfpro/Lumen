[Unit]
Description=Lumen one-click update runner
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
UMask=0007
# release 布局：runner 始终从 current 启动 update.sh；update.sh 内部会把 ROOT
# 解析回 /opt/lumen，并在 ${ROOT}/releases/<new_id>/ 下做新一轮发布。
WorkingDirectory=/opt/lumen/current
Environment=LUMEN_UPDATE_REQUEST=/opt/lumendata/backup/.update.request.json
Environment=LUMEN_UPDATE_JOURNAL=/opt/lumen/shared/.update-journal.json
Environment=LUMEN_UPDATE_RECOVERY_MARKER=/opt/lumen/shared/.update-resume
Environment=LUMEN_UPDATE_TRIGGER=/opt/lumendata/backup/.update.trigger
Environment=LUMEN_UPDATE_RUNNING=/opt/lumendata/backup/.update.running
Environment=LUMEN_UPDATE_CLAIM=/opt/lumen/shared/.update-claim.json
StandardOutput=append:/opt/lumendata/backup/.update.log
StandardError=append:/opt/lumendata/backup/.update.log
# timeout gives the runner its own wall-clock guard in addition to systemd's
# TimeoutStartSec, so a wedged child process cannot sit for the full unit cap.
ExecStart=/usr/bin/env timeout --preserve-status --kill-after=300s 7200s python3 /opt/lumen/current/scripts/update_runner.py
# Preserve the request while an active journal needs automatic resume.
ExecStopPost=/usr/bin/python3 -I /opt/lumen/current/scripts/update_runner.py --cleanup
# 7200s 上限：弱网下 docker pull 多 GB 镜像 + 偶发 npm/uv 兜底 build 可能 > 1h；
# 比 infinity 稳（卡住时仍会被 systemd 终结），又留出充足窗口避免误杀正常更新。
TimeoutStartSec=7300
TimeoutStopSec=300
KillSignal=SIGTERM
KillMode=mixed
Restart=on-failure
RestartSec=5s
