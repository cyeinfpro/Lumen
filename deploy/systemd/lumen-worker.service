[Unit]
Description=Lumen Worker
After=network-online.target docker.service lumen-storage-mount.service
Wants=network-online.target
Requires=docker.service lumen-storage-mount.service

[Service]
Type=simple
User=lumen
Group=lumen
WorkingDirectory=/opt/lumen/current/apps/worker
EnvironmentFile=-/opt/lumen/shared/.env
# LUMEN_VERSION 从 EnvironmentFile 读取，由 deploy/scripts/sync_env_version.sh 在每次发布时刷新。
Environment=PYTHONUNBUFFERED=1
Environment=LUMEN_WORKER_HEALTH_STATE_FILE=/opt/lumen/shared/worker-var/worker-health.json
# Privileged mount repair belongs to lumen-storage-mount.service.
ExecStartPre=/usr/local/sbin/lumen-storage-mount verify
ExecStartPre=/usr/bin/test -w /opt/lumendata/storage
ExecStart=/opt/lumen/current/.venv/bin/python -m app.worker_health run
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
# worker 在 update / rollback 时被 systemctl restart 触发，arq 收到 SIGTERM 会
# 停止接新任务并等待 in-flight job 完成。给 180s 让大多数短任务（≤60s）干净结束；
# 4K 长任务（per project_lumen_4k_timeout_envelope.md 可达 1500s）超时仍会 SIGKILL，
# 由 image queue failover 机制重新入队。这比原来 20s 大幅降低中断概率。
TimeoutStopSec=180s
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
CapabilityBoundingSet=
# worker var/ is the only writable shared subtree; release code and .env stay
# read-only even if the worker process is compromised.
ReadWritePaths=/opt/lumendata/storage /opt/lumen/shared/worker-var
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumen-worker

[Install]
WantedBy=multi-user.target
